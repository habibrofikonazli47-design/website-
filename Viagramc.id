<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Minecraft Rank Store</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Poppins', sans-serif;
    }

    body{
      background:#0d1117;
      color:white;
      overflow-x:hidden;
    }

    /* BACKGROUND */
    body::before{
      content:"";
      position:fixed;
      inset:0;
      background:
        radial-gradient(circle at top left,#00ffcc33,transparent 25%),
        radial-gradient(circle at bottom right,#8a2be233,transparent 25%),
        #0d1117;
      z-index:-1;
    }

    /* NAVBAR */
    nav{
      width:100%;
      padding:20px 8%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      position:fixed;
      top:0;
      backdrop-filter:blur(10px);
      background:rgba(0,0,0,0.35);
      border-bottom:1px solid rgba(255,255,255,0.1);
      z-index:1000;
    }

    .logo{
      font-size:28px;
      font-weight:700;
      color:#00ffd5;
      text-shadow:0 0 15px #00ffd5;
    }

    nav a{
      color:white;
      text-decoration:none;
      margin-left:25px;
      transition:0.3s;
    }

    nav a:hover{
      color:#00ffd5;
    }

    /* HERO */
    .hero{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      flex-direction:column;
      text-align:center;
      padding:120px 20px 50px;
    }

    .hero h1{
      font-size:72px;
      font-weight:700;
      background:linear-gradient(90deg,#00ffd5,#8a2be2);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
      margin-bottom:20px;
    }

    .hero p{
      max-width:700px;
      color:#bdbdbd;
      font-size:20px;
      margin-bottom:35px;
    }

    .hero button{
      padding:16px 40px;
      border:none;
      border-radius:14px;
      background:linear-gradient(90deg,#00ffd5,#8a2be2);
      color:white;
      font-size:18px;
      font-weight:600;
      cursor:pointer;
      transition:0.3s;
      box-shadow:0 0 20px #00ffd577;
    }

    .hero button:hover{
      transform:translateY(-4px) scale(1.03);
      box-shadow:0 0 30px #00ffd5;
    }

    /* RANK SECTION */
    .ranks{
      padding:80px 8%;
    }

    .section-title{
      text-align:center;
      font-size:42px;
      margin-bottom:50px;
    }

    .cards{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:30px;
    }

    .card{
      background:rgba(255,255,255,0.05);
      border:1px solid rgba(255,255,255,0.1);
      backdrop-filter:blur(12px);
      border-radius:25px;
      padding:35px;
      transition:0.4s;
      position:relative;
      overflow:hidden;
    }

    .card::before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(135deg,#00ffd522,transparent,#8a2be222);
      opacity:0;
      transition:0.4s;
    }

    .card:hover::before{
      opacity:1;
    }

    .card:hover{
      transform:translateY(-10px);
      box-shadow:0 0 25px rgba(0,255,213,0.3);
    }

    .rank-name{
      font-size:32px;
      font-weight:700;
      margin-bottom:10px;
    }

    .price{
      font-size:40px;
      color:#00ffd5;
      margin-bottom:20px;
      font-weight:700;
    }

    .features{
      list-style:none;
      margin-bottom:30px;
    }

    .features li{
      margin:12px 0;
      color:#cfcfcf;
    }

    .buy-btn{
      width:100%;
      padding:14px;
      border:none;
      border-radius:12px;
      background:linear-gradient(90deg,#00ffd5,#8a2be2);
      color:white;
      font-weight:600;
      font-size:16px;
      cursor:pointer;
      transition:0.3s;
    }

    .buy-btn:hover{
      transform:scale(1.03);
      box-shadow:0 0 20px #00ffd5;
    }

    /* FOOTER */
    footer{
      text-align:center;
      padding:40px 20px;
      color:#888;
      border-top:1px solid rgba(255,255,255,0.08);
      margin-top:60px;
    }

    /* RESPONSIVE */
    @media(max-width:768px){
      .hero h1{
        font-size:48px;
      }

      .hero p{
        font-size:16px;
      }
    }
  </style>
</head>

<body>

  <nav>
    <div class="logo">MineStore</div>

    <div>
      <a href="#">Home</a>
      <a href="#rank">Rank</a>
      <a href="#">Discord</a>
      <a href="#">Store</a>
    </div>
  </nav>

  <section class="hero">
    <h1>Upgrade Rank Minecraft Kamu</h1>

    <p>
      Dapatkan rank eksklusif dengan fitur keren, kit premium,
      akses VIP, dan banyak keuntungan lainnya di server Minecraft terbaik!
    </p>

    <button onclick="document.getElementById('rank').scrollIntoView({behavior:'smooth'})">
      Lihat Rank
    </button>
  </section>

  <section class="ranks" id="rank">

    <h2 class="section-title">Pilih Rank Kamu</h2>

    <div class="cards">

      <div class="card">
        <div class="rank-name">VIP</div>
        <div class="price">Rp10K</div>

        <ul class="features">
          <li>✔ Prefix VIP</li>
          <li>✔ Kit Harian</li>
          <li>✔ Akses Warp VIP</li>
          <li>✔ 2 Homes</li>
        </ul>

        <button class="buy-btn">Beli Sekarang</button>
      </div>

      <div class="card">
        <div class="rank-name">MVP</div>
        <div class="price">Rp30K</div>

        <ul class="features">
          <li>✔ Semua Fitur VIP</li>
          <li>✔ Fly Mode</li>
          <li>✔ 5 Homes</li>
          <li>✔ Money Booster</li>
        </ul>

        <button class="buy-btn">Beli Sekarang</button>
      </div>

      <div class="card">
        <div class="rank-name">LEGEND</div>
        <div class="price">Rp60K</div>

        <ul class="features">
          <li>✔ Semua Fitur MVP</li>
          <li>✔ Custom Nick</li>
          <li>✔ Particle Effect</li>
          <li>✔ Priority Queue</li>
        </ul>

        <button class="buy-btn">Beli Sekarang</button>
      </div>

    </div>
  </section>

  <footer>
    © 2026 MineStore Minecraft Server • All Rights Reserved
  </footer>

</body>
</html>
